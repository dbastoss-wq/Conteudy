# Copie para .env (local) ou cadastre na Vercel: Project Settings > Environment Variables.
# Nunca coloque os valores reais no Git.

# --- WhatsApp Cloud API (app da Meta, produto WhatsApp) ---
WHATSAPP_ACCESS_TOKEN=          # token permanente de Usuário do Sistema (Business Settings > System Users)
WHATSAPP_APP_SECRET=            # App Settings > Basic > App Secret (confere a assinatura dos webhooks)
WHATSAPP_PHONE_NUMBER_ID=       # WhatsApp > API Setup > Phone number ID (não é o número de telefone)
WHATSAPP_VERIFY_TOKEN=          # invente uma senha longa; use a mesma ao configurar o webhook na Meta

# --- Claude (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5  # padrão; claude-haiku-5-5 custa menos (sem fallback automático)
# CLAUDE_EFFORT=low             # low | medium | high

# --- Memória das conversas (obrigatório em produção) ---
REDIS_URL=                      # rediss://… (Upstash ou Redis Cloud, pelo Marketplace da Vercel)

# --- Avisos para a equipe (opcional, recomendado) ---
EQUIPE_WHATSAPP=                # celular que recebe os avisos, com 55 e DDD. Ex.: 5511999998888
# EQUIPE_TEMPLATE=aviso_equipe  # modelo aprovado na Meta com uma variável {{1}}; sem ele, a equipe precisa
                                # mandar uma mensagem ao número do assistente a cada 24 h
# PAUSA_APOS_ENCAMINHAR_HORAS=12  # depois de passar para a equipe, o assistente fica em silêncio nessa conversa

# --- Formulário da página (já vem certo; mude só se a página mudar) ---
# NETLIFY_FORM_URL=https://agenda-dr-daniel.netlify.app/
# NETLIFY_FORM_NAME=agendamento-dr-daniel
# BOT_DEBOUNCE_MS=2000          # espera mensagens em sequência antes de responder
