# Copie para .env. Nunca faça commit das credenciais.
COMPANY_NAME=
AGENT_NAME=Assistente
AGENT_EMAIL=
AGENT_TIMEZONE=America/Sao_Paulo
KNOWLEDGE_PATH=knowledge/company.md
DATABASE_PATH=data/agent.sqlite3

# Caixa real do Google Workspace. AGENT_EMAIL deve ser o endereço principal autenticado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

CALENDLY_SCHEDULING_URL=
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_SYNC_SECONDS=900
CALENDLY_LOOKBACK_DAYS=30
CALENDLY_AHEAD_DAYS=365

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gere um token aleatório de pelo menos 32 caracteres para a API administrativa.
ADMIN_API_TOKEN=
# false: gera rascunhos locais. true: envia as novas respostas automaticamente.
AUTO_SEND=false
RUN_WORKER=true
POLL_SECONDS=60
# Na primeira execução, importa até 7 dias de mensagens anteriores na caixa de entrada.
INITIAL_LOOKBACK_DAYS=7
