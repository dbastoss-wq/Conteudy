APP_ENV=production
APP_BASE_URL=https://configure-seu-dominio.example
# Gerado por python -m consulta.cli init. Guarde uma cópia separada dos backups.
APP_ENCRYPTION_KEY=
APP_DATA_DIR=data
SESSION_SECONDS=43200
SESSION_IDLE_SECONDS=1800
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Só habilite a IA após configurar o tratamento de dados com o provedor.
AI_ENABLED=false
# Raízes, CRLs e manifesto obtidos e conferidos pelo administrador a partir do ITI.
ICP_TRUST_DIR=trust
ICP_TRUST_MANIFEST=
SIGNATURE_REVOCATION_REQUIRED=true
