# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_BASE_URL=https://seu-dominio.com
PORT=3000
NODE_ENV=production
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — API OFICIAL apenas
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=troque-por-uma-string-aleatoria
WHATSAPP_APP_SECRET=app-secret-do-painel-meta
WHATSAPP_ACCESS_TOKEN=token-permanente-de-envio
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Google Calendar (conta do médico, OAuth offline)
# Gere o refresh token uma vez com: npm run oauth:google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback   # usado só por `npm run oauth:google`; cadastre este mesmo valor no Google
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# LLM — usado SÓ para interpretar mensagens e redigir textos curtos.
# Nunca decide disponibilidade nem agenda.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5      # ex.: claude-haiku-5-5 (anthropic) ou gpt-4o-mini (openai)

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://secretaria:secretaria@localhost:5432/secretaria
# Senha do Postgres do docker-compose (o app dentro do compose usa esta variável)
POSTGRES_PASSWORD=secretaria
# Domínio público para o HTTPS automático (Caddy) — o webhook da Meta exige HTTPS
DOMAIN=seu-dominio.com

# ---------------------------------------------------------------------------
# Segurança
# ENCRYPTION_KEY: 32 bytes em base64 -> gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
JWT_SECRET=troque-isto
ENCRYPTION_KEY=
ADMIN_EMAIL=dr.daniel@exemplo.com
ADMIN_PASSWORD=defina-no-primeiro-seed

# ---------------------------------------------------------------------------
# Negócio / pagamento
# ---------------------------------------------------------------------------
CONSULT_PRICE_CENTS=7000
PIX_KEY=dc.bastos@icloud.com

# ---------------------------------------------------------------------------
# LGPD
# ---------------------------------------------------------------------------
DATA_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Notificações ao médico (urgência, falha, cartão, comprovante, fora do roteiro)
# ---------------------------------------------------------------------------
DOCTOR_NOTIFY_CHANNEL=both      # whatsapp | email | both
DOCTOR_WHATSAPP_NUMBER=5511999999999
DOCTOR_EMAIL=dr.daniel@exemplo.com
# Opcional: template aprovado na Meta (corpo com uma variável {{1}}). Sem ele, alerta
# por WhatsApp fora da janela de 24h é recusado e cai para o e-mail.
DOCTOR_ALERT_TEMPLATE=
DOCTOR_ALERT_TEMPLATE_LANG=pt_BR
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Secretaria Virtual <no-reply@seu-dominio.com>

# ---------------------------------------------------------------------------
# Modo de teste: true = não envia ao WhatsApp real; captura os envios.
# ---------------------------------------------------------------------------
SIMULATE_WHATSAPP=false

# Modo de teste da agenda: true = agenda falsa em memória (não cria eventos reais)
SIMULATE_CALENDAR=false
